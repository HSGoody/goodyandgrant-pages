<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Clovenhoof 2048</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#120707;
  color:white;
  overflow:hidden;
  touch-action:none;
}
.container{
  display:flex;
  gap:16px;
  padding:12px;
  height:100vh;
}
.left{flex:1;display:flex;flex-direction:column}
.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:10px;
}
h1{margin:0;font-size:48px}
.board-wrap{
  flex:1;
  display:flex;
  justify-content:center;
  align-items:center;
}
.board{
  position:relative;
  width:min(78vw,78vh*0.7);
  height:min(78vw/0.7,78vh);
  background:#3b1d1d;
  border-radius:16px;
  padding:10px;
}
.grid{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  grid-template-rows:repeat(5,1fr);
  gap:10px;
  width:100%;
  height:100%;
}
.cell{
  background:rgba(255,255,255,0.08);
  border-radius:10px;
}
.tile-layer{
  position:absolute;
  inset:10px;
}
.tile{
  position:absolute;
  border-radius:10px;
  background-size:cover;
  background-position:center;
  overflow:hidden;
  transition:left 0.22s ease, top 0.22s ease;
  box-shadow:0 8px 18px rgba(0,0,0,0.45);
}
.tile::after{
  content:'';
  position:absolute;
  inset:0;
  background:linear-gradient(to bottom,rgba(0,0,0,0),rgba(0,0,0,0.35));
}
.label{
  position:absolute;
  bottom:0;
  left:0;
  right:0;
  z-index:2;
  background:rgba(0,0,0,0.7);
  padding:4px;
  font-size:10px;
  text-align:center;
  font-weight:bold;
}
.sidebar{
  width:300px;
  background:#231010;
  border-radius:16px;
  padding:16px;
  overflow:auto;
}
.sidebar img{
  width:100%;
  border-radius:10px;
}
button{
  background:#b41f1f;
  color:white;
  border:none;
  border-radius:8px;
  padding:10px 14px;
  font-weight:bold;
}
a.buy{
  display:inline-block;
  margin-top:12px;
  background:#b41f1f;
  color:white;
  padding:10px 14px;
  border-radius:8px;
  text-decoration:none;
  font-weight:bold;
}
@media(max-width:900px){
  body{overflow:auto}
  .container{flex-direction:column;height:auto}
  .sidebar{width:auto}
  .board{
    width:min(94vw,70vh*0.7);
    height:min(94vw/0.7,70vh);
  }
}
</style>
</head>
<body>
<div class="container">
<div class="left">
<div class="topbar">
<div>
<h1>Clovenhoof 2048</h1>
<div>Merge matching books.</div>
</div>
<button onclick="startGame()">Restart</button>
</div>
<div class="board-wrap">
<div class="board" id="board">
<div class="grid" id="grid"></div>
<div class="tile-layer" id="tiles"></div>
</div>
</div>
</div>
<div class="sidebar" id="sidebar"></div>
</div>

<script>
const BOOKS = {
2:["Clovenhoof","data:image/jpeg;base64,","Satan loses his job and is sent to Birmingham."],
4:["Pigeonwings","data:image/jpeg;base64,","Heaven has its own terrible bureaucracy."],
8:["Godsquad","data:image/jpeg;base64,","Holy warriors arrive."],
16:["Hellzapoppin'","data:image/jpeg;base64,","Hell itself starts wobbling."],
32:["Beelzebelle","data:image/jpeg;base64,","Everything gets worse."],
64:["Hooflandia","data:image/jpeg;base64,","Fantasy chaos expands."],
128:["Holymoly","data:image/jpeg;base64,","Angels and idiocy collide."],
256:["Alpacalypse","data:image/jpeg;base64,","The alpacas are involved."],
512:["Hankypanky","data:image/jpeg;base64,","Supernatural romance and disaster."],
1024:["Babelicious","data:image/jpeg;base64,","Reality starts breaking."]
};

const SIZE=5;
let grid=[];
let tileMap={};
let idCounter=1;

const gridEl=document.getElementById('grid');
const tilesEl=document.getElementById('tiles');

for(let i=0;i<25;i++){
  const d=document.createElement('div');
  d.className='cell';
  gridEl.appendChild(d);
}

function startGame(){
  grid=Array.from({length:SIZE},()=>Array(SIZE).fill(null));
  tileMap={};
  tilesEl.innerHTML='';
  addRandom();
  addRandom();
  renderSidebar();
}

function addRandom(){
  const empty=[];
  for(let r=0;r<SIZE;r++){
    for(let c=0;c<SIZE;c++){
      if(!grid[r][c]) empty.push([r,c]);
    }
  }
  if(!empty.length) return;
  const [r,c]=empty[Math.floor(Math.random()*empty.length)];
  const value=Math.random()<0.9?2:4;
  const id=idCounter++;
  grid[r][c]={id,value};
  createTile(id,value,r,c);
}

function createTile(id,value,r,c){
  const tile=document.createElement('div');
  tile.className='tile';
  tile.dataset.id=id;

  const info=BOOKS[value];
  if(info){
    tile.style.backgroundImage=`url(${info[1]})`;
    tile.innerHTML=`<div class="label">${info[0]}</div>`;
  } else {
    tile.style.background='#500';
    tile.innerHTML=`<div class="label">Book 11?</div>`;
  }

  tilesEl.appendChild(tile);
  tileMap[id]=tile;
  positionTile(tile,r,c);
}

function positionTile(tile,r,c){
  const layer=tilesEl.getBoundingClientRect();
  const gap=10;
  const w=(layer.width-gap*4)/5;
  const h=(layer.height-gap*4)/5;

  tile.style.width=w+'px';
  tile.style.height=h+'px';
  tile.style.left=(c*(w+gap))+'px';
  tile.style.top=(r*(h+gap))+'px';
}

function move(dir){
  let moved=false;

  function processLine(cells){
    const vals=cells.filter(Boolean);

    for(let i=0;i<vals.length-1;i++){
      if(vals[i] && vals[i+1] && vals[i].value===vals[i+1].value){
        vals[i].value*=2;

        const oldTile=tileMap[vals[i+1].id];
        if(oldTile){
          oldTile.remove();
          delete tileMap[vals[i+1].id];
        }

        vals.splice(i+1,1);
      }
    }

    while(vals.length<SIZE) vals.push(null);
    return vals;
  }

  for(let n=0;n<SIZE;n++){
    let line=[];

    for(let i=0;i<SIZE;i++){
      if(dir==='left') line.push(grid[n][i]);
      if(dir==='right') line.push(grid[n][SIZE-1-i]);
      if(dir==='up') line.push(grid[i][n]);
      if(dir==='down') line.push(grid[SIZE-1-i][n]);
    }

    const old=JSON.stringify(line.map(v=>v?v.value:0));
    line=processLine(line);
    const now=JSON.stringify(line.map(v=>v?v.value:0));

    if(old!==now) moved=true;

    for(let i=0;i<SIZE;i++){
      let cell=line[i];

      if(dir==='left') grid[n][i]=cell;
      if(dir==='right') grid[n][SIZE-1-i]=cell;
      if(dir==='up') grid[i][n]=cell;
      if(dir==='down') grid[SIZE-1-i][n]=cell;

      if(cell){
        const tile=tileMap[cell.id];
        if(tile){
          let rr,cc;
          if(dir==='left'){rr=n;cc=i;}
          if(dir==='right'){rr=n;cc=SIZE-1-i;}
          if(dir==='up'){rr=i;cc=n;}
          if(dir==='down'){rr=SIZE-1-i;cc=n;}

          if(BOOKS[cell.value]){
            tile.style.backgroundImage=`url(${BOOKS[cell.value][1]})`;
            tile.innerHTML=`<div class="label">${BOOKS[cell.value][0]}</div>`;
          }

          positionTile(tile,rr,cc);
        }
      }
    }
  }

  if(moved){
    setTimeout(()=>{
      addRandom();
      renderSidebar();
    },220);
  }
}

function renderSidebar(){
  let max=2;

  for(let r=0;r<SIZE;r++){
    for(let c=0;c<SIZE;c++){
      if(grid[r][c]) max=Math.max(max,grid[r][c].value);
    }
  }

  const side=document.getElementById('sidebar');
  const b=BOOKS[max];

  if(!b){
    side.innerHTML='<h2>Book 11?</h2>';
    return;
  }

  side.innerHTML=`
    <img src="${b[1]}">
    <h2>${b[0]}</h2>
    <p>${b[2]}</p>
    <a class="buy" target="_blank" href="https://www.amazon.co.uk/s?k=${encodeURIComponent(b[0])}">View on Amazon</a>
  `;
}

document.addEventListener('keydown',e=>{
  if(e.key==='ArrowLeft') move('left');
  if(e.key==='ArrowRight') move('right');
  if(e.key==='ArrowUp') move('up');
  if(e.key==='ArrowDown') move('down');
});

let sx=0,sy=0;

document.getElementById('board').addEventListener('touchstart',e=>{
  const t=e.touches[0];
  sx=t.clientX;
  sy=t.clientY;
},{passive:false});

document.getElementById('board').addEventListener('touchmove',e=>{
  e.preventDefault();
},{passive:false});

document.getElementById('board').addEventListener('touchend',e=>{
  e.preventDefault();
  const t=e.changedTouches[0];
  const dx=t.clientX-sx;
  const dy=t.clientY-sy;

  if(Math.abs(dx)>Math.abs(dy)){
    if(dx>30) move('right');
    if(dx<-30) move('left');
  } else {
    if(dy>30) move('down');
    if(dy<-30) move('up');
  }
},{passive:false});

window.addEventListener('resize',()=>{
  for(let r=0;r<SIZE;r++){
    for(let c=0;c<SIZE;c++){
      const cell=grid[r][c];
      if(cell){
        positionTile(tileMap[cell.id],r,c);
      }
    }
  }
});

startGame();
</script>
</body>
</html>
